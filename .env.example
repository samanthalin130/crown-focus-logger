# Only needed for MODE=live (recording from a real Crown).
# Mock mode needs none of this.
#
# Copy this file to .env and fill it in. .env is gitignored and never leaves
# this machine. These credentials go to Neurosity, and to nobody else.

# Your Neurosity account email
NEUROSITY_EMAIL=

# Your Neurosity account password
NEUROSITY_PASSWORD=

# Your device ID. Optional: only needed if your account has more than one
# device. Find it in the Neurosity console under Settings.
NEUROSITY_DEVICE_ID=
