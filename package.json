{
  "name": "crown-focus-logger",
  "version": "2.0.0",
  "description": "Record Neurosity Crown focus, calm and band power to a CSV you own, then read it back in your browser. Local-first: your data never leaves your device.",
  "main": "logger.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samanthalin130/crown-focus-logger.git"
  },
  "keywords": ["neurosity", "crown", "eeg", "bci", "focus", "logger", "local-first"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node logger.js",
    "mock": "MODE=mock node logger.js",
    "live": "MODE=live node logger.js",
    "test": "node test/run-tests.mjs",
    "web": "node scripts/serve-web.js",
    "sample": "node scripts/make-sample.js"
  },
  "dependencies": {
    "@neurosity/sdk": "^7.5.1",
    "dotenv": "^16.4.5"
  }
}
